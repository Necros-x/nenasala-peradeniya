get.value as IntakeRecord["status"]})} className="h-9 w-full rounded-md border border-border bg-transparent px-3">{["draft","upcoming","open","closing_soon","full","active","completed","closed"].map(s=><option key={s} value={s}>{s.replace("_"," ")}</option>)}</select></div></div><DialogFooter><Button type="button" variant="outline" onClick={()=>setOpen(false)}>Cancel</Button><Button disabled={pending||readOnlyDemo}>{pending?"Saving...":"Save Intake"}</Button></DialogFooter></form></DialogContent></Dialog></div>
